
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atrr-forum",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
